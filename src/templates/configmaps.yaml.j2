# Source: https://github.com/kubeflow/dashboard/blob/v2.0.1/components/centraldashboard/manifests/kustomize/base/configmap.yaml
apiVersion: v1
data:
  links: |-
    {
      "menuLinks": {{ menuLinks }},
      "externalLinks": {{ externalLinks }},
      "quickLinks": {{ quickLinks }},
      "documentationItems": {{ documentationItems }}
    }

  settings: '{{ settings }}'
kind: ConfigMap
metadata:
  name: {{ configmap_name }}
  namespace: {{ namespace }}
